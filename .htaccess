#Header set X-Frame-Options DENY
#Header always append X-Frame-Options SAMEORIGIN

# block access to any .env file, wherever it lives
<FilesMatch "^\.env">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

RewriteEngine On

# page introuvable -> page "woops"
ErrorDocument 404 /woops.html

RewriteRule ^(temp)($|/) - [L]

# fichier ou dossier réel : servir tel quel
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# accueil
RewriteRule ^$ /index.html [L]

# lien profond vers un article existant (/AAAA-MM-JJ ou /AAAA-MM-JJ_N) : charger la SPA
RewriteCond %{DOCUMENT_ROOT}/articles/$1.html -f
RewriteRule ^(\d{4}-\d{2}-\d{2}(?:_\d+)?)/?$ /index.html [QSA,L]

# page fixe (ex: /about) : charger la SPA si le html correspondant existe
RewriteCond %{DOCUMENT_ROOT}/articles/$1.html -f
RewriteRule ^([a-z][a-z0-9_-]*)/?$ /index.html [QSA,L]

# tout le reste ne pointe sur rien : woops (404)
RewriteRule ^ - [R=404,L]
